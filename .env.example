# ─── Bangkok Shambhala — Environment Variables ───
# Copy this file to .env.local and fill in the values.

# Site URL (used for canonical URLs, OG images, etc.)
NEXT_PUBLIC_SITE_URL=https://shambhala-bangkok.org

# Newsletter — Brevo (Sendinblue)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_LIST_ID=1

# Analytics — Plausible (self-hosted or cloud)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=shambhala-bangkok.org

# Admin authentication (for /admin routes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Optional: Cloudinary for image hosting
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Formspree for contact forms
FORMSPREE_ENDPOINT=

# Optional: n8n webhook for automation triggers
N8N_WEBHOOK_URL=
